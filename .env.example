# required: TinyFish (Search, Fetch, TinyResearch, Agent)
TINYFISH_API_KEY=

# optional but recommended: Claude Haiku judges each page (states / mentions / debunks). Without it the rule-based judgement is used.
ANTHROPIC_API_KEY=

# spend and abuse protection (defaults shown). Per server instance, best effort.
HAIKU_DAILY_MAX=300        # max Haiku calls per day (each ~ $0.0005)
RESEARCH_DAILY_MAX=8       # max TinyResearch runs per day (each ~ $2)
AGENT_DAILY_MAX=15         # max Agent browser checks per day
TRACE_RATE_MAX=12          # traces per visitor per 10 minutes (deployed site only)

# set to 1 to start TinyResearch with every trace (default: it is a button, because each run costs credits)
NEXT_PUBLIC_AUTO_DEEP=
# set to 1 to turn Haiku off
DISABLE_HAIKU=
